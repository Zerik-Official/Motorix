{
  "name": "auth-api",
  "version": "0.1.0",
  "description": "Users, roles, permissions and JWT issuance of Motorix.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun prisma generate",
    "db:migrate": "bun --bun prisma migrate deploy",
    "postinstall": "bun --bun prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "prisma": "~7.10.1",
    "supertest": "^7.3.1",
    "typescript": "^6",
    "typescript-eslint": "^8.72.1"
  }
}
