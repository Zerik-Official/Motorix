APP_NAME=auth-api
ENVIRONMENT=local
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0

DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=auth_service
DB_PASSWORD=change-me-auth
DB_POOL_SIZE=5

JWT_PRIVATE_KEY_PATH=../../secrets/jwt/private.pem
JWT_PRIVATE_KEY=
JWT_ISSUER=motorix-auth-api
JWT_AUDIENCE=motorix-business-api
JWT_EXPIRES_IN_SECONDS=3600

MAX_PAGE_SIZE=100

TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX=10

ROOT_EMAIL=root@motorix.local
ROOT_PASSWORD=change-me-root-password
ROOT_FULL_NAME=Root

LOG_LEVEL=INFO
LOG_VERBOSITY=1
LOG_SUPPRESS=
LOG_TO_FILE=true
LOG_DIR=logs
